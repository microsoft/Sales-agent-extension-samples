# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=sit
APP_NAME_SUFFIX= (SIT)
AGENT_SCOPE=shared

# ---------------------------------------------------------------------------
# AGENT IDENTITY — provision once, then COMMIT the values ATK writes back here.
#
# TEAMS_APP_ID *is* the identity of this agent in the tenant. The `teamsApp/create`
# action creates a BRAND NEW app — i.e. a duplicate agent — whenever this value is
# empty or points at an app that no longer exists in the signed-in tenant.
# ATK writes the id back into THIS file (not .env.sit.user) after a successful
# provision. Commit it so every later provision/publish, on any machine and in CI,
# UPDATES the same agent instead of creating another one.
#
# Never blank these out to "redeploy", and never bump AGENT_VERSION by resetting
# this file — that is exactly what produces duplicate agents in the tenant.
# ---------------------------------------------------------------------------
TEAMS_APP_ID=
# Written back by copilotAgent/publish in the `provision` lifecycle (scope = AGENT_SCOPE).
M365_TITLE_ID=
M365_APP_ID=
SHARE_LINK=
# Written back by copilotAgent/publish in the `publish` lifecycle (scope = tenant).
M365_PUBLISHED_TITLE_ID=
M365_PUBLISHED_APP_ID=

# App package version. Bump this to ship a NEW VERSION of the SAME agent.
# A version bump must never be accompanied by a change to TEAMS_APP_ID.
AGENT_VERSION=1.0.0

# ---------------------------------------------------------------------------
# OPTIONAL — Dynamics / Dataverse environment for THIS stage (SIT).
# These are DISABLED by default. Uncomment and fill them ONLY when your tools
# need them, then reference them from your tool/plugin manifests (OpenAPI/MCP)
# as ${VAR_NAME}. Do NOT reference a variable that is left commented/empty —
# ATK fails packaging if a ${{...}} token in the manifest has no value.
# ---------------------------------------------------------------------------
# DATAVERSE_ENVIRONMENT_NAME=Contoso Sales - SIT
# DATAVERSE_ENVIRONMENT_ID=
# DATAVERSE_ENVIRONMENT_URL=
# Base URL your external tools/flows call for this environment (Power Automate / API gateway / MCP server).
# TOOL_BASE_URL=
# Auth client id used by your external tools in this environment.
# TOOL_CLIENT_ID=

# Environment variables for Agent Evaluations
AZURE_AI_OPENAI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=
AZURE_AI_MODEL_NAME=
